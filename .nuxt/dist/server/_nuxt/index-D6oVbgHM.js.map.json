: background-color 0.3s;\n  cursor: pointer;\n}\n\n.mobile-menu a:hover {\n  background-color: var(--primary);\n}\n\n.mobile-menu a:last-child {\n  border-bottom: none;\n}\n\n/* Hero */\n.hero {\n  height: 400px;\n  background-color: #d9d9d9;\n}\n\n/* Sections */\n.section {\n  padding: 100px 0;\n}\n\n.section h2 {\n  font-size: 48px;\n  font-weight: 700;\n  text-align: center;\n  margin-bottom: 12px;\n  letter-spacing: -1px;\n}\n\n.section-desc {\n  font-size: 16px;\n  color: var(--text-light);\n  text-align: center;\n  margin-bottom: 60px;\n  font-weight: 300;\n}\n\n.grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 30px;\n}\n\n.grid img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.3s;\n}\n\n.grid img:hover {\n  transform: scale(1.05);\n}\n\n/* Background colors for each section */\n.collab-bg {\n  background-color: #ffffff;\n}\n\n.amazon-bg {\n  background-color: #faf7f2;\n}\n\n.target-bg {\n  background-color: #f5f3f0;\n}\n\n.blog-bg {\n  background-color: #f0ebe5;\n}\n\n.meet-bg {\n  background-color: #ebe6e0;\n}\n\n.recent-bg {\n  background-color: #f8f6f3;\n}\n\n.why-bg {\n  background-color: #f0ebe5;\n}\n\n/* Features Grid */\n.features-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 40px;\n}\n\n.feature-card {\n  text-align: center;\n}\n\n.feature-num {\n  font-size: 48px;\n  font-weight: 700;\n  color: var(--accent);\n  margin-bottom: 16px;\n  display: block;\n}\n\n.feature-card h3 {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text);\n  margin-bottom: 12px;\n  letter-spacing: -0.5px;\n}\n\n.feature-card p {\n  font-size: 14px;\n  color: var(--text-light);\n  line-height: 1.6;\n}\n\n@media (max-width: 768px) {\n  .features-grid {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 30px;\n  }\n}\n\n/* Meet Elen */\n.about-grid {\n  display: grid;\n  grid-template-columns: 1fr 1.2fr;\n  gap: 80px;\n  align-items: center;\n}\n\n.about-grid img {\n  width: 100%;\n  height: auto;\n}\n\n.about-content h2 {\n  font-size: 44px;\n  font-weight: 700;\n  margin-bottom: 12px;\n  letter-spacing: -1px;\n}\n\n.subtitle {\n  font-size: 16px;\n  color: var(--accent);\n  font-weight: 600;\n  margin-bottom: 30px;\n  letter-spacing: 0.5px;\n  text-transform: uppercase;\n}\n\n.about-content p {\n  font-size: 16px;\n  color: var(--text-light);\n  line-height: 1.8;\n  margin-bottom: 24px;\n  font-weight: 400;\n}\n\n.stats {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 40px;\n  margin-top: 50px;\n  padding-top: 50px;\n  border-top: 1px solid var(--border);\n}\n\n.stats h3 {\n  font-size: 32px;\n  font-weight: 700;\n  color: var(--accent);\n  margin-bottom: 8px;\n}\n\n.stats p {\n  font-size: 13px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n}\n\n/* Footer */\n.footer-new {\n  background: var(--primary);\n  padding: 80px 60px;\n  margin-top: 80px;\n}\n\n.footer-content {\n  max-width: 1400px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 100px;\n  align-items: flex-start;\n}\n\n.footer-image {\n  width: 280px;\n  height: 350px;\n  overflow: hidden;\n  border-radius: 4px;\n}\n\n.footer-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.footer-columns {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 60px;\n}\n\n.footer-column h3 {\n  font-family: 'Playfair Display', 'Didot', serif;\n  font-size: 18px;\n  font-weight: 400;\n  letter-spacing: 3px;\n  text-transform: uppercase;\n  color: var(--text);\n  margin-bottom: 24px;\n}\n\n.footer-column ul {\n  list-style: none;\n  padding: 0;\n}\n\n.footer-column li {\n  margin-bottom: 12px;\n}\n\n.footer-column a {\n  font-size: 13px;\n  color: var(--text-light);\n  text-decoration: none;\n  transition: color 0.3s;\n  cursor: pointer;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.footer-column a:hover {\n  color: var(--text);\n}\n\n@media (max-wi